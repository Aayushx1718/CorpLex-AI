APP_ENV=development
DATABASE_URL=postgresql+psycopg://corplex:corplex_local@localhost:5432/corplex
CORS_ORIGINS=["http://localhost:5173"]
POSTGRES_USER=corplex
POSTGRES_PASSWORD=corplex_local
POSTGRES_DB=corplex

# Optional. Enter real values only in ignored local configuration or secure runtime settings.
CORPLEX_ACCESS_TOKEN=
CORPLEX_REVIEW_TOKEN=
CORPLEX_LLM_API_KEY=
CORPLEX_LLM_MODEL=gpt-4.1-mini
# For an actual domain, configure explicit JSON lists:
# ALLOWED_HOSTS=["example.com"]
# CORS_ORIGINS=["https://example.com"]
# CONTAINER_DATABASE_URL=postgresql+psycopg://USER:PERCENT_ENCODED_PASSWORD@db:5432/DATABASE

# Real local username/password setup is enabled by default. Existing token mode
# takes precedence when CORPLEX_ACCESS_TOKEN is set. Never commit passwords.
CORPLEX_PASSWORD_LOGIN=true
